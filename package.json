{
  "name": "rust-belt-era",
  "version": "1.0.0",
  "description": "锈带纪元 - Frame Maiden wasteland runner RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "live": "vite",
    "prebuild": "node scripts/ensure-ui-assets.mjs && node scripts/build-tex-ship.mjs && node scripts/sync-tex-assets.mjs && node scripts/verify-ship-gate.mjs && node scripts/verify-ship-p2.mjs",
    "assets:build-ship": "node scripts/build-tex-ship.mjs",
    "assets:build-ship:force": "node scripts/build-tex-ship.mjs --force",
    "assets:sync": "node scripts/sync-tex-assets.mjs",
    "assets:audit": "node scripts/verify-ship-gate.mjs && node scripts/verify-ship-p2.mjs",
    "assets:verify": "node scripts/verify-ship-gate.mjs && node scripts/verify-ship-p2.mjs",
    "assets:verify:android": "node scripts/verify-ship-gate.mjs --android",
    "build": "tsc && vite build",
    "slice-wasteland-ui": "node scripts/slice-wasteland-ui.mjs",
    "slice-sub-ui": "node scripts/slice-sub-ui.mjs",
    "generate-avatars": "node scripts/generate-character-avatars.mjs",
    "extract-camp-routes": "node scripts/extract-camp-routes.mjs",
    "preview": "node scripts/serve.cjs",
    "preview:dist": "npm run build && node scripts/serve.cjs",
    "preview:mobile": "npm run build && node scripts/serve.cjs",
    "preview:ai": "vite --open /ai-living-preview.html",
    "preview:combat": "vite --open /combat-billboard-preview.html",
    "preview:title": "vite --open /title-poster-preview.html",
    "preview:game": "vite --open /game-preview.html",
    "dev:mobile": "vite --host 0.0.0.0 --port 5173",
    "export-preview": "npm run build && node scripts/export-preview.cjs",
    "cap:sync": "npm run build && npx cap sync android && npm run assets:verify:android",
    "cap:open": "npx cap open android",
    "icons:apply": "node scripts/apply-app-icon.mjs",
    "build:apk": "npm run icons:apply && npm run cap:sync && npm run assets:verify:android && node scripts/build-apk.cjs debug",
    "build:apk:release": "npm run icons:apply && npm run cap:sync && npm run assets:verify:android && node scripts/build-apk.cjs release",
    "verify-bullet-sync": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-bullet-sync.mjs",
    "verify-combat": "node scripts/verify-combat-logic.mjs",
    "verify-dialogue-sync": "node scripts/verify-dialogue-sync.mjs",
    "verify-discipline-invite": "tsx scripts/verify-discipline-invite.mjs",
    "test:gateway": "node scripts/test-license-gateway.mjs",
    "smoke:qwen": "node scripts/smoke-qwen.mjs",
    "verify-character-scale": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-combat-character-scale.mjs",
    "verify-portrait-fit": "node scripts/verify-portrait-fit.mjs",
    "verify-sr01-live": "node scripts/verify-sr01-live-portrait.mjs",
    "convert-live-portraits": "node scripts/convert-live-portraits.mjs",
    "verify-character-portraits": "node scripts/verify-character-portraits.mjs",
    "verify-p0": "tsx scripts/verify-p0-fixes.mjs",
    "verify-story-guide": "tsx scripts/verify-story-guide.mjs",
    "smoke:story-guide": "tsx scripts/smoke-story-guide.mjs",
    "verify-layout": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/verify-combat-layout.mjs",
    "verify-mobile-ui": "node scripts/verify-mobile-ui.mjs",
    "export:static-cards": "tsx scripts/export_static_character_cards.mts",
    "setup:home-gpu": "powershell -ExecutionPolicy Bypass -File scripts/setup-home-gpu.ps1",
    "setup:cloudflare-tunnel": "powershell -ExecutionPolicy Bypass -File scripts/setup-cloudflare-tunnel.ps1",
    "start:remote-gpu": "powershell -ExecutionPolicy Bypass -File scripts/start-remote-gpu.ps1",
    "watch:remote-gpu": "powershell -ExecutionPolicy Bypass -File scripts/watch-remote-gpu.ps1",
    "verify-mobile-squad-touch": "npm run build && node scripts/verify-mobile-squad-touch.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "phaser": "^3.80.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.184.1",
    "playwright-core": "^1.49.1",
    "sharp": "^0.35.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.125.0"
  }
}
